    <ThingDef ParentName="BuildingFloorCoveringMediumBase">
    <defName>FurryTrash_Rug_Medium</defName>
    <label>FurryTrash rug (medium)</label>
    <description>Furry Smut for your floor.</description>
    <dominantStyleCategory>FurryTrash</dominantStyleCategory>
    <statBases>
      <Flammability>0.32</Flammability>
    </statBases>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Building/BuildingStyles/FurryTrash/Rugs/RugMedium</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <comps>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    <costList>
      <Cloth>100</Cloth>
    </costList>
  </ThingDef>

